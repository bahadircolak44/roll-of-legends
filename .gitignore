# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# --- Unity generated ---
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files
*.blend1
*.blend1.meta

# MemoryCaptures / Recordings can get large and may contain sensitive data
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin + personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE caches
.vs/
.idea/
.vscode/
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports / Mono
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.apks
*.ipa
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Test Runner generated scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- Secrets: NEVER commit these (public repo) ---
*.keystore
*.keystore.meta
*.jks
*.jks.meta
*.p12
*.mobileprovision
.env
.env.*
user.keystore

# OS files
.DS_Store
Thumbs.db
