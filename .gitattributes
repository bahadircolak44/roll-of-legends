# --- Code & text ---
*.cs                  text eol=lf diff=csharp
*.shader              text eol=lf
*.hlsl                text eol=lf
*.cginc               text eol=lf
*.compute             text eol=lf
*.shadergraph         text eol=lf
*.shadersubgraph      text eol=lf
*.vfx                 text eol=lf
*.asmdef              text eol=lf
*.asmref              text eol=lf
*.inputactions        text eol=lf
*.uss                 text eol=lf
*.uxml                text eol=lf
*.json                text eol=lf
*.md                  text eol=lf
*.sh                  text eol=lf

